# --- General ---
APP_ENV=development
DEBUG=true

# --- Data provider ---
# "mock" (default): realistic in-memory sample data, no external calls required.
# "live": placeholder for a future authorized data provider integration.
DATA_PROVIDER_MODE=mock
DATA_PROVIDER_API_KEY=
DATA_PROVIDER_BASE_URL=

# --- Upstash Redis (optional in mock mode; required for real caching) ---
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Rate limiting (future use) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Apify (generic platform client) ---
# Auth token only. app/clients/apify_client.py is a generic, actor-agnostic
# HTTP wrapper around Apify's API — it does not call any specific Actor by
# itself. Wire it up to a specific, authorized Actor explicitly in your own
# DataProviderClient implementation.
APIFY_API_TOKEN=

# --- RapidAPI proxy protection ---
# Set this to the secret shown in your RapidAPI provider dashboard
# (Security tab). When set, all /ads/* and /trends/* requests must carry a
# matching X-RapidAPI-Proxy-Secret header or they are rejected with 403.
# Leave empty in local development to skip this check.
RAPIDAPI_PROXY_SECRET=
